{
	"name": "@d1g1tal/subscribr",
	"author": "D1g1talEntr0py",
	"version": "4.2.1",
	"license": "MIT",
	"description": "JavaScript Publish/Subscribe Library",
	"homepage": "https://github.com/D1g1talEntr0py/subscribr#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/D1g1talEntr0py/subscribr.git"
	},
	"bugs": {
		"url": "https://github.com/D1g1talEntr0py/subscribr/issues"
	},
	"maintainers": [
		{
			"name": "D1g1talEntr0py",
			"email": "jason.dimeo@gmail.com"
		}
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.3.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"type": "module",
	"types": "./dist/subscribr.d.ts",
	"exports": {
		".": {
			"types": "./dist/subscribr.d.ts",
			"import": "./dist/subscribr.js"
		}
	},
	"files": [
		"/dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsbuild",
		"build:minify": "tsbuild --minify --force",
		"build:watch": "tsbuild --watch",
		"type-check": "tsbuild --noEmit",
		"lint": "eslint ./src",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@d1g1tal/collections": "^2.2.2"
	},
	"devDependencies": {
		"@d1g1tal/tsbuild": "1.9.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "^8.59.4",
		"@typescript-eslint/parser": "^8.59.4",
		"@vitest/coverage-v8": "^4.1.7",
		"eslint": "^10.4.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-jsdoc": "^63.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vitest": "^4.1.7"
	},
	"browserslist": [
		"defaults and fully supports es6-module",
		"node >= 22"
	],
	"keywords": [
		"JavaScript",
		"ObserverPattern",
		"Publish/Subscribe"
	]
}
